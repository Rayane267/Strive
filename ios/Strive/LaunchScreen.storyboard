<?xml version="1.0" encoding="UTF-8"?>
<!--
  L'IMAGE 0 DU SPLASH, ET RIEN D'AUTRE.

  Apple n'anime pas l'écran de lancement : il est rendu par le système avant que
  la moindre ligne de l'app ne tourne. Il est donc forcément le point de départ
  de `StriveSplashView`, qui prend le relais par-dessus la rootView.

  D'où la tuile VIDE : dans la vue SwiftUI, à t = 0, les trois capsules ne sont
  pas encore tracées et le wordmark est à l'opacité 0. Y poser le wordmark ici
  le ferait disparaître au démarrage de l'animation pour réapparaître en fondu —
  exactement le saut que cette continuité sert à éviter.

  ⚠️ LA TUILE EST UNE IMAGE, et ce n'est pas un choix esthétique. Un écran de
  lancement REFUSE les attributs runtime : une vue colorée arrondie par
  `layer.cornerRadius` fait échouer la compilation du storyboard
  (« Launch screens may not contain user-defined runtime attributes »), donc le
  build entier. `SplashTile` est une superellipse n=5 — la forme des icônes iOS,
  celle du vrai logo, et ce que `RoundedRectangle(style: .continuous)` approxime
  côté SwiftUI.

  Les valeurs doivent rester d'accord avec `StriveSplashView` :
    tuile 120 × 120, #1C2E24 · fond #0A120E
    centre décalé de -57 : la pile logo + wordmark (120 + 28 + 67) est centrée
    puis remontée de 9,6 pt, ce qui place le centre du logo à -57 du centre.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22155" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22131"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleAspectFit" image="SplashTile" translatesAutoresizingMaskIntoConstraints="NO" id="tiL-e0-001">
                                <rect key="frame" x="127.5" y="276.5" width="120" height="120"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="120" id="tiL-W1-002"/>
                                    <constraint firstAttribute="height" constant="120" id="tiL-H1-003"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" red="0.039215686274509803" green="0.070588235294117647" blue="0.054901960784313725" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="tiL-e0-001" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="tiL-CX-004"/>
                            <constraint firstItem="tiL-e0-001" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" constant="-57" id="tiL-CY-005"/>
                        </constraints>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="52.173913043478265" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="SplashTile" width="120" height="120"/>
    </resources>
</document>
